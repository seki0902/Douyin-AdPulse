# Do not stage untracked local drafts from shared source directories by accident.
/docs/*
/scripts/*
!/scripts/serve_dashboard.py
!/scripts/open_dashboard.ps1
/tests/*
!/tests/test_dashboard_report_ui.py

# Root-level local launch notes and command files are not publishable by default.
/*.cmd
!/open_dashboard.cmd
/*.md
!/README.md
!/DASHBOARD_README.md
